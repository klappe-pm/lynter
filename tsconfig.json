{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "ES2020"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["plugin/src/**/*.ts", "plugin/test/**/*.ts", "packages/site/**/*.ts"],
  "exclude": ["**/node_modules", "**/.next", "**/out"]
}
