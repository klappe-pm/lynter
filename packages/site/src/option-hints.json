        "straight",
        "smart"
      ]
    },
    "double-quote-enabled": {
      "description": "Normalize double quotes."
    },
    "double-quote-style": {
      "description": "Double quote style to enforce.",
      "choices": [
        "straight",
        "smart"
      ]
    }
  },
  "remove-trailing-punctuation-in-heading": {
    "trailing-punctuation": {
      "description": "Characters stripped from the end of headings."
    }
  },
  "remove-yaml-keys": {
    "keys": {
      "description": "Frontmatter keys to delete."
    }
  },
