  "paragraph-spacing": {
    "blank-lines": {
      "description": "Number of blank lines between blocks (0, 1 or 2)."
    }
  },
  "list-style": {
    "marker": {
      "description": "Bullet marker to use for unordered lists.",
      "choices": [
        "-",
        "*"
      ]
    },
    "tighten": {
      "description": "Remove blank lines between list items."
    }
  },
  "dedupe-yaml-array-values": {
    "dedupe-aliases": {
      "description": "Remove duplicate values from the aliases key."
    },
    "dedupe-tags": {
      "description": "Remove duplicate values from the tags key."
    },
    "dedupe-arrays": {
      "description": "Remove duplicate values from other frontmatter lists."
    },
    "keys-to-ignore": {
      "description": "Frontmatter keys whose lists are left untouched."
    }
  },
  "default-language-for-code-fences": {
    "language": {
      "description": "Language added to code fences that have none; empty means no change."
    }
  },
  "emphasis-style": {
    "style": {
      "description": "Character used for emphasis; consistent follows the first one found.",
      "choices": [
        "consistent",
        "asterisk",
        "underscore"
      ]
    }
  },
  "empty-line-around-math-block": {
    "number-of-dollar-signs": {
      "description": "Number of dollar signs that open a math block."
    }
  },
  "escape-yaml-special-characters": {
    "default-escape-character": {
      "description": "Quote character used when a frontmatter value needs quoting.",
      "choices": [
        "\"",
        "'"
      ]
    },
    "escape-single-line-arrays": {
      "description": "Also quote the items of single-line frontmatter lists."
    }
  },
  "format-yaml-arrays": {
    "format-aliases": {
      "description": "Reformat the aliases list."
    },
    "aliases-style": {
      "description": "Layout of the aliases list.",
      "choices": [
        "single-line",
        "multi-line",
        "single string comma delimited",
        "single string space delimited",
        "single string to single-line",
        "single string to multi-line"
      ]
    },
    "format-tags": {
      "description": "Reformat the tags list."
    },
    "tags-style": {
      "description": "Layout of the tags list.",
      "choices": [
        "single-line",
        "multi-line",
        "single string comma delimited",
        "single string space delimited",
        "single string to single-line",
        "single string to multi-line"
      ]
    },
    "format-arrays": {
      "description": "Reformat other frontmatter lists."
    },
    "default-array-style": {
      "description": "Layout of other frontmatter lists.",
      "choices": [
        "single-line",
        "multi-line",
        "single string comma delimited",
        "single string space delimited",
        "single string to single-line",
        "single string to multi-line"
      ]
    },
    "force-single-line-keys": {
      "description": "Keys whose lists are always written on a single line."
    },
    "force-multi-line-keys": {
      "description": "Keys whose lists are always written on multiple lines."
    }
  },
  "header-increment": {
    "start-at-level-2": {
      "description": "Treat level 2 as the first allowed heading level."
    }
  },
  "heading-blank-lines": {
    "bottom": {
      "description": "Require a blank line after each heading."
    },
    "empty-line-between-yaml-and-header": {
      "description": "Require a blank line between frontmatter and a leading heading."
    }
  },
  "insert-yaml-attributes": {
    "text-to-insert": {
      "description": "Frontmatter lines added to notes that lack those keys, one key per line."
    }
  },
  "move-tags-to-yaml": {
    "body-tag-operation": {
      "description": "What to do with each tag in the body after it is copied to frontmatter.",
      "choices": [
        "nothing",
        "remove-hashtag",
        "remove-whole-tag"
      ]
    },
    "tags-to-ignore": {
      "description": "Body tags that are not moved to frontmatter."
    }
  },
  "ordered-list-style": {
    "number-style": {
      "description": "Numbering of ordered lists: counting up, or every item numbered 1.",
      "choices": [
        "ascending",
        "lazy"
      ]
    },
    "end-style": {
      "description": "Character after the number in ordered list items.",
      "choices": [
        ".",
        ")"
      ]
    }
  },
  "quote-style": {
    "single-quote-enabled": {
      "description": "Normalize single quotes."
    },
