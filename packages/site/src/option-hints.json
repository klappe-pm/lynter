        "kebab-case",
        "Title Case",
        "underscore_formatted"
      ]
    },
    "h2": {
      "description": "Case style for level 2 headings; leave empty to keep them as written.",
      "choices": [
        "camelCase",
        "First letter",
        "kebab-case",
        "Title Case",
        "underscore_formatted"
      ]
    },
    "h3": {
      "description": "Case style for level 3 headings; leave empty to keep them as written.",
      "choices": [
        "camelCase",
