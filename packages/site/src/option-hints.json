{
  "strip-strong": {
    "keep-heading-strong": {
      "description": "Keep strong emphasis inside headings."
    }
  },
  "replace-em-dash": {
    "replacement": {
      "description": "Text that replaces each em dash or connector en dash."
    },
    "word-joining": {
      "description": "Also replace dashes that join two words with no spaces around them."
    }
  },
  "header-case": {
    "h1": {
      "description": "Case style for level 1 headings; leave empty to keep them as written.",
