  "yaml-key-sort": {
    "priority-keys": {
      "description": "Frontmatter keys placed first, in this order."
    },
    "defaults": {
      "description": "Keys and values added when a note lacks them."
    }
  },
  "yaml-timestamp": {
    "schema": {
      "description": "Names of the frontmatter keys that hold the created and revised dates."
    }
  },
  "task-format": {
    "normalize-spacing": {
      "description": "Normalize the spaces around the task checkbox."
    },
    "lowercase-marker": {
      "description": "Write the done marker as a lowercase x."
