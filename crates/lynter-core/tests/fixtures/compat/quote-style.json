    },
    {
      "n": 6,
      "input": "Use `\"x\"` and \"y\"\n",
      "options": {
        "single-quote-style": "smart",
        "double-quote-style": "smart"
      },
      "expected": "Use `\"x\"` and “y”\n"
    },
    {
      "n": 7,
      "input": "it’s fine\n",
      "options": {},
      "expected": "it's fine\n"
    },
    {
      "n": 8,
