{
  "id": "consecutive-blank-lines",
  "examples": [
    {
      "n": 1,
      "input": "Some text\n\n\nSome more text\n",
      "options": {},
      "expected": "Some text\n\nSome more text\n"
    },
    {
      "n": 2,
      "input": "a\n\n\n\n\n\nb\n",
      "options": {},
      "expected": "a\n\nb\n"
    },
    {
      "n": 3,
      "input": "a\n  \n\t\nb\n",
      "options": {},
