    },
    {
      "n": 4,
      "input": "```\na\n\n\nb\n```\n",
      "options": {},
      "expected": "```\na\n\n\nb\n```\n"
    },
    {
      "n": 5,
      "input": "> a\n>\n>\n> b\n",
      "options": {},
      "expected": "> a\n>\n>\n> b\n"
    },
    {
      "n": 6,
      "input": "---\na: 1\n\n\nb: 2\n---\n\n\ntext\n",
      "options": {},
      "expected": "---\na: 1\n\n\nb: 2\n---\n\ntext\n"
    },
    {
      "n": 7,
      "input": "a\r\n\r\n\r\nb",
      "options": {},
